APP_NAME="BeautyPro HQ"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://beautyprohq.com
FRONTEND_URL=https://beautyprohq.com
APP_TIMEZONE=Africa/Lagos
TRUSTED_HOSTS=beautyprohq.com,www.beautyprohq.com
TRUSTED_PROXIES=

SANCTUM_STATEFUL_DOMAINS=beautyprohq.com,www.beautyprohq.com
CORS_ALLOWED_ORIGINS=https://beautyprohq.com,https://www.beautyprohq.com

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_LEVEL=warning
LOG_DAILY_DAYS=7
LOG_DEPRECATIONS_CHANNEL=null
SECURITY_LOG_LEVEL=notice
SECURITY_LOG_DAILY_DAYS=14
# After setting a webhook URL, change this to LOG_STACK=daily,slack.
LOG_SLACK_WEBHOOK_URL=
LOG_SLACK_LEVEL=critical

DB_CONNECTION=mysql
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_EXPIRE_ON_CLOSE=false
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax
SESSION_DOMAIN=

CACHE_STORE=database
RATE_LIMITER_STORE=database
CACHE_PREFIX=beautyprohq_production_

QUEUE_CONNECTION=database
QUEUE_FAILED_DRIVER=database-uuids
DB_QUEUE_RETRY_AFTER=90

FILESYSTEM_DISK=local
UPLOAD_DISK=public

MAIL_MAILER=smtp
MAIL_SCHEME=smtp
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_REQUIRE_TLS=true
MAIL_FROM_ADDRESS=hello@beautyprohq.com
MAIL_FROM_NAME="${APP_NAME}"
MAIL_TIMEOUT=15

PAYSTACK_PUBLIC_KEY=
PAYSTACK_SECRET_KEY=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_URL=
AWS_ENDPOINT=
AWS_USE_PATH_STYLE_ENDPOINT=false

HTTP_CONNECT_TIMEOUT=5
HTTP_TIMEOUT=15
SLOW_REQUEST_THRESHOLD_MS=1500
SECURITY_CSP_ENABLED=true
SECURITY_HSTS_ENABLED=true
SECURITY_HSTS_MAX_AGE=31536000
SECURITY_UPGRADE_INSECURE_REQUESTS=true
SECURITY_USER_UPLOAD_QUOTA_BYTES=104857600
SECURITY_ADMIN_UPLOAD_QUOTA_BYTES=1073741824
SECURITY_ORPHAN_UPLOAD_RETENTION_DAYS=7
SECURITY_MALWARE_SCAN_ENABLED=true
SECURITY_MALWARE_SCAN_REQUIRED=true
SECURITY_CLAMD_HOST=127.0.0.1
SECURITY_CLAMD_PORT=3310
SECURITY_CLAMD_TIMEOUT=15
SECURITY_ADMIN_STEP_UP_LIFETIME=600
SECURITY_ADMIN_REQUIRE_TWO_FACTOR=true

VITE_APP_NAME="${APP_NAME}"
