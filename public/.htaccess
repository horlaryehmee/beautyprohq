<IfModule mod_rewrite.c>
    <IfModule mod_negotiation.c>
        Options -MultiViews -Indexes
    </IfModule>

    RewriteEngine On

    # Block hidden files except ACME challenges used for HTTPS certificates.
    RewriteRule "(^|/)\.(?!well-known/)" - [F,L]

    # Handle Authorization Header
    RewriteCond %{HTTP:Authorization} .
    RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]

    # Handle X-XSRF-Token Header
    RewriteCond %{HTTP:x-xsrf-token} .
    RewriteRule .* - [E=HTTP_X_XSRF_TOKEN:%{HTTP:X-XSRF-Token}]

    # Redirect Trailing Slashes If Not A Folder...
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_URI} (.+)/$
    RewriteRule ^ %1 [L,R=301]

    # Missing compiled assets must fail as assets, not fall through to the SPA shell.
    RewriteCond %{REQUEST_URI} ^/build/assets/
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteRule ^ - [R=404,L]

    # Send Requests To Front Controller...
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteRule ^ index.php [L]
</IfModule>

<IfModule mod_headers.c>
    Header always unset X-Powered-By
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header always set Permissions-Policy "camera=(), geolocation=(), microphone=(), payment=(self)"

    SetEnvIf X-Forwarded-Proto "https" bphq_https
    Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains" env=bphq_https

    SetEnvIf Request_URI "^/build/assets/" bphq_immutable_asset
    Header always set Cache-Control "public, max-age=31536000, immutable" env=bphq_immutable_asset

    SetEnvIf Request_URI "^/build/manifest\.json$" bphq_build_manifest
    Header always set Cache-Control "no-store, no-cache, must-revalidate, max-age=0" env=bphq_build_manifest

    SetEnvIf Request_URI "^/storage/uploads/.*\.(avif|webp|png|jpe?g|gif|svg)$" bphq_upload_asset
    Header always set Cache-Control "public, max-age=31536000, immutable" env=bphq_upload_asset
</IfModule>

<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE application/javascript application/json application/ld+json application/xml image/svg+xml text/css text/html text/javascript text/plain text/xml
</IfModule>

<FilesMatch "(^\.|\.env|\.log|\.sql|\.sqlite|composer\.(json|lock)|package(-lock)?\.json|phpunit\.xml)$">
    Require all denied
</FilesMatch>
